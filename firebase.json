      "firebase.json",
      ".gitignore",
      "node_modules/**",
      "proxy.js",
      "package.json",
      "package-lock.json",
      "proxy_out.txt"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
