{
  "version": 2,
  "builds": [
    {
      "src": "proxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/proxy", "destination": "/proxy.js" },
    { "source": "/image-gen", "destination": "/proxy.js" },
    { "source": "/api/(.*)", "destination": "/proxy.js" }
  ]
}
